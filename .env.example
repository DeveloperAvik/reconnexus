# ReconNexus environment (copy to .env or export directly)

# Postgres connection used by the control plane and migration runner.
RECONNEXUS_DATABASE_URL=postgres://localhost:5432/reconnexus

# Optional Redis (not required; the Postgres queue is authoritative).
# RECONNEXUS_REDIS_URL=redis://127.0.0.1:6379

# Local artifact storage root.
# RECONNEXUS_ARTIFACTS_DIR=./.reconnexus/artifacts

# Logging.
RECONNEXUS_LOG_LEVEL=info
RECONNEXUS_LOG_FORMAT=json

# Hard-override to permit restricted address space. Leave unset for safety.
# RECONNEXUS_ALLOW_RESTRICTED=false

# Optional provider credential variables consumed by providers, e.g.:
# SUBFINDER_CONFIG=~/.config/subfinder/provider-config.yaml
