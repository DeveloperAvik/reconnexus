[
  {
    "name": "aws access key id",
    "rule": "aws-access-key-id",
    "text": "const k = 'AKIAABCDEFGHIJKLMNOP';"
  },
  {
    "name": "aws secret access key",
    "rule": "aws-secret-access-key",
    "text": "aws_secret_access_key = 'AbCdEfGhIjKlMnOpQrStUvWxYz0123456789ABCD'"
  },
  {
    "name": "google api key",
    "rule": "google-api-key",
    "text": "const g = 'AIza01234567890123456789012345678901234';"
  },
  {
    "name": "slack token",
    "rule": "slack-token",
    "text": "const s = 'xoxb-123456789012-abcdefghijklmnop';"
  },
  {
    "name": "github token",
    "rule": "github-token",
    "text": "const t = 'ghp_ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghij';"
  },
  {
    "name": "stripe live key",
    "rule": "stripe-secret-key",
    "text": "const p = 'sk_live_ABCDEFGHIJKLMNOPQRSTUVWX';"
  },
  {
    "name": "twilio key",
    "rule": "twilio-api-key",
    "text": "const auth_token = 'SK0123456789abcdef0123456789abcdef';"
  },
  {
    "name": "password assignment",
    "rule": "password-assignment",
    "text": "const password = 'Xq7!kLm2Zp9#Wv4';"
  },
  {
    "name": "private key marker",
    "rule": "private-key",
    "text": "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\n-----END RSA PRIVATE KEY-----"
  },
  {
    "name": "database url",
    "rule": "database-connection-string",
    "text": "const db = 'postgres://admin:P4ssw0rd@db.internal:5432/app';"
  },
  {
    "name": "oauth client secret",
    "rule": "oauth-client-secret",
    "text": "client_secret: 'abcdefghijklmnop1234'"
  },
  {
    "name": "webhook signing secret",
    "rule": "webhook-signing-secret",
    "text": "signing_secret = 'whsec_abcdefghijklmnop1234'"
  },
  {
    "name": "jwt token",
    "rule": "jwt-token",
    "text": "const j = 'eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJVadQssw5c';"
  },
  {
    "name": "bearer token",
    "rule": "bearer-token",
    "text": "Authorization: Bearer abcdefghij1234567890klmnop"
  },
  {
    "name": "azure account key",
    "rule": "azure-storage-account-key",
    "text": "AccountKey=01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ01aZ"
  },
  {
    "name": "sql string (negative)",
    "rule": null,
    "text": "const q = 'SELECT * FROM users WHERE id = 1';"
  },
  {
    "name": "semver (negative)",
    "rule": null,
    "text": "const version = '1.2.3';"
  },
  {
    "name": "placeholder api key (negative)",
    "rule": null,
    "text": "const cfg = { api_key: 'your_api_key_here' };"
  },
  {
    "name": "changeme password (negative)",
    "rule": null,
    "text": "password = 'changeme'"
  },
  {
    "name": "email (negative)",
    "rule": null,
    "text": "const email = 'user@example.com';"
  },
  {
    "name": "url (negative)",
    "rule": null,
    "text": "const url = 'https://example.com/path';"
  },
  {
    "name": "color hex (negative)",
    "rule": null,
    "text": "const color = '#ffffff';"
  },
  {
    "name": "numeric id (negative)",
    "rule": null,
    "text": "const id = '12345';"
  },
  {
    "name": "plain word (negative)",
    "rule": null,
    "text": "const s = 'hello world';"
  },
  {
    "name": "unknown token var (negative)",
    "rule": null,
    "text": "const replacement = 'abcdefghijklmnopqrstuvwxyz0123456789';"
  },
  {
    "name": "bare SK without context (negative)",
    "rule": null,
    "text": "const id = 'SK0123456789abcdef0123456789abcdef';"
  },
  {
    "name": "low-entropy password (negative)",
    "rule": null,
    "text": "const cfg = { password: 'required' };"
  },
  {
    "name": "repeated-character bearer (negative)",
    "rule": null,
    "text": "Authorization: Bearer aaaaaaaaaaaaaaaaaaaaaaaa"
  }
]
